{
  "name": "HomeDash",
  "short_name": "HomeDash",
  "description": "Your day, organized — calendar, tasks, habits and widgets in one dashboard.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b0f1a",
  "theme_color": "#0b0f1a",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Add a widget", "url": "/?action=add-widget", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Settings", "url": "/?action=settings", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
